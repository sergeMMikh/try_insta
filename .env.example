# Environment variables template
# Copy this file to .env and fill in your actual values

# Database configuration
DATABASE_URL=sqlite:///db.sqlite3

# Instagram/Meta API
META_TOKEN=your_meta_access_token_here
IG_USER_ID=your_instagram_user_id_here
META_GRAPH_VERSION=v25.0
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_meta_verify_token_here

# Reply mode for Instagram comments (draft, auto, manual)
IG_REPLY_MODE=draft
IG_REPLY_PROVIDER=chat

# OpenAI chat provider
OPENAI_API_KEY=your_openai_api_key_here

# Dify chat provider
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_RESPONSE_MODE=blocking
DIFY_TIMEOUT_SECONDS=30

# Optional Dify webhook forwarding for workflow trigger integrations
DIFY_WEBHOOK_URL=https://trigger.ai-plugin.io/triggers/webhook-debug/your_webhook_id
